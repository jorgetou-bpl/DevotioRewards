# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URL=
DB_NAME=

# JWT auth — generate a strong random value for production, e.g. `openssl rand -hex 32`
JWT_SECRET=
ADMIN_MASTER_CODE=

# Boomerangme API
BOOMERANG_API_BASE=https://api.digitalwallet.cards/api/v2
BOOMERANG_API_KEY=

# CORS — comma-separated list of allowed origins, plus an optional regex for
# Vercel preview deployments (e.g. ^https://devotio-scanner(-git-[a-z0-9-]+)?-[a-z0-9-]+\.vercel\.app$)
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
